# Smart Connections runtime data (embeddings/logs — churns constantly, not meaningful history)
.smart-env/

# Obsidian UI state (machine-specific — rewritten on every window move / layout change)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Local REST API HTTPS private key (machine-specific, regenerated by plugin)
.obsidian/plugins/obsidian-local-rest-api/data.json

# Recent Files plugin runtime data (rewritten constantly)
.obsidian/plugins/recent-files-obsidian/data.json
